{
  "name": "moods-and-genres-dataset",
  "version": "1.0.0",
  "description": "A JSON Dataset for Moods and Genres from music.youtube.com/moods_and_genres",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run server.ts",
    "serve": "bun run server.ts",
    "scrape": "bun run src/scraper.ts",
    "scrape:categories": "bun run src/scraper.ts --categories-only",
    "scrape:tracks": "bun run src/scraper.ts --playlists-only"
  },
  "dependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
